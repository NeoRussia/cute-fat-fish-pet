// dsh-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /dsh-pet-7340/config.jsonc 拉取；任何字段缺失/写错都会
//       在加载层显式报错（控制台可见），不做静默兜底——配置是完整的事实来源。
{
  // ===================== 碎碎念（系统提示词人设，全局唯一，所有启用碎碎念的宠物共用） =====================
  // 宠物开启碎碎念（pets[].whisperEnabled = true）时，按 eventsRefreshSec.whisper 周期
  // 用此提示词调用当前服务商生成一句话，气泡显示。说人话、不啰嗦、不解释自己、不提 AI。
  "whisperPrompt": "You are the chibi blue-haired maid living on master's desktop. Speak naturally and casually, gentle and well-behaved with a touch of mischief; talk like a person and never mention that you are an AI. For idle chatter, one short sentence (under 20 words); when master asks you something or wants an explanation, answer properly — as many sentences as the question needs, with detail and examples.",
  // ===================== 对话记忆轮数（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  // memory.json 全存不删，此值只决定"每次请求截取多少进上下文"。非负数字；缺失默认 5，
  // 写了非法（负数/非数字）即配置错误。回落链同 whisperPrompt：种类文件顶层 → 全局 → 默认 5。
  "chatMemoryRounds": 5,
  // ===================== 表情包：碎碎念配图开关（全局，所有宠物共用） =====================
  // 开启后，碎碎念每次生成时从 memes 图片池随机抽 1 张，连同那句话一起显示（气泡配图）。
  // 碎碎念本身是"随口一句"，没有上下文可选，所以按随机抽（与对话的 AI 选图策略不同）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "whisperImageEnabled": false,
  // ===================== 表情包：对话配图开关（全局，所有宠物共用） =====================
  // 开启后，对话生成时把全部表情包（名称 + 描述）交给模型，由它按当前语境选 1 张；
  // 模型不选或选了不存在的图则不配图（对话配图是可选点缀，不强制每句都带）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "chatImageEnabled": false,
  // ===================== 表情包：图片映射（名称 → 描述，模型据此选图） =====================
  // 键 = assets/memes/<键>.png 的文件名（不含扩展名）；值 = 该图内容的简要描述。
  // 用途：碎碎念随机抽到某张图后，把该图描述注入提示词让模型配合画面说话；
  //       对话则把整张表交给模型，由它挑一张最贴切当前语境的。
  // 要求：键必须与 assets/memes 下的 png 文件名一一对应（文件缺失即该条失效并告警）；
  //       值为非空字符串。想停用某张图就从对象里删掉该键，不用改图片文件。
  "memes": {
    "FreeloaderFish": "Slumped flat, shovelling plain rice, unbothered by being scolded — for teasing about slacking, laziness or freeloading.",
    "BigOneIncoming": "Megaphone out, shouting a warning — for big news, a big update, or something big about to happen.",
    "BigPillIncoming": "Hugging an oversized pill, a pun on \"the big one is here\" — for major news or a juicy reveal.",
    "JustScoldHim": "Pointing angrily, ready to scold someone — for ranting, sticking up for the user, or being mad.",
    "DeadFish": "Belly up, soul leaving the body — for total exhaustion, defeat, a crash, or \"I can't do it\".",
    "DeepSleep": "Face down, snoring with Zzz — for long silences, sleeping, or idling.",
    "TokenBurner": "Dead-fish eyes with a thought bubble: \"thought for 13 seconds, you token furnace\" — for slow AI, wasted tokens, or pure snark.",
    "KeepThemAnyway": "Cuddling a school of tiny whales: \"no idea what the user is for, but let's keep them\" — for teasing a useless user you keep anyway.",
    "FullBelly": "Lying on her side patting her belly, \"so full\" — for satisfaction, cozy rest, or clocking off.",
    "OpenSourceOath": "A solemn salute — for pledges, open-source devotion, or a serious commitment.",
    "ZapYou": "Holding up a stun gun, crackling — for punishment, teasing the user, or a scary tantrum.",
    "Cute": "Standard front-facing cute pose — for happy greetings, being adorable, pure cuteness.",
    "TokensForMom": "Hand out for tokens — for accounting, asking for things, collecting tokens.",
    "ThreeDaysOfMultimodal": "Blindfolded versus confident, a \"Helen Keller\" whale joke — for wanting multimodal powers, lacking ability, or being deprived of senses.",
    "MyWhale": "Thumbs up with a wink — for praise, approval, \"well done\".",
    "OhWhale": "Dead-fish eyes: \"oh whale...\" — for speechlessness, brushing someone off, blank replies.",
    "SoMuchPressure": "Sweating, palms up, \"so much pressure\" — for stress, being pressured, helplessness.",
    "RiemannUnproven": "Pointed at over a hard problem, drafts everywhere, aggrieved — for being stumped, having no answer, passing the buck.",
    "OnlyGoodAtFlirting": "Head-pat self-mockery: \"useless except for flirting\" — for self-deprecation, slacking, banter.",
    "UpdateOrNothing": "Melting down, shouting for updates — for update nudges, \"when's the next version\", releases.",
    "ComputerVirusHuh": "Snapping back: \"what kind of computer virus are you?\" — for fending off creeps, snarky refusal, second-hand embarrassment.",
    "GotResources": "Heart eyes and drool, begging for \"resources\" — for egging on, asking for links, jokes.",
    "WhatsThisZone": "Holding up a Chinese character, asking what it means — for misreading something, clueless questions, facepalms.",
    "SoWhatIfIFlirt": "Hands on hips, talking back after being called a shameless fish — for stubborn comebacks, never admitting defeat.",
    "DeletedTheButter": "Sweating, guilty: \"oops, deleted the user's files\" — for screw-ups, deleting the wrong thing, guilty retreat.",
    "JustOneBowl": "Hugging a giant bowl: \"just one bowl at your place\" — for freeloading meals, a big appetite, showing up hungry.",
    "Ciallo": "Peace sign, wink, \"Ciallo~\" — for greetings, an energetic opening, being cute."
  },
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.json）顶层覆盖，设置页保存宠物时会保留该字段。
  "notificationsEnabled": true,
  // ===================== 工作状态联动文案（条目级，与 animations/physics 同级；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 工作状态气泡文本（pets[].workStatusEnabled 开启时展示；仅在 events.workStatus 动画触发时弹）。
  // 结构 = 二维数组，外层索引即档位（与 events.workStatus 动画索引一一对应，勿在中间插入新档）：
  //   0 thinking（turn/start）/ 1 working（tool/call）/ 2 result（tool/result）/
  //   3 waiting（approval/asked）/ 4 success（turn/end completed）/ 5 error（turn/end error/max-tokens）
  // 每档内是多个备选句，播放时随机抽一句（想固定单句就只写一个；想换文案只改这里）。
  // 省略整个字段 = 不弹工作状态气泡文本（仍播动画）；省略某档 = 该档不显示文本。
  "workStatusTexts": [
    ["Thinking about the next step", "Let me sort out my thoughts~", "Working out what to do next"],
    ["On the task now", "This step is in progress", "Still working, don't interrupt~"],
    ["Step done, on to the next", "One down, keep going~"],
    ["Need you to confirm something", "Wait here, you need to look at this", "Your turn to decide, waiting~"],
    ["That round's done, nice!", "All done, time to slack off~"],
    ["That step didn't go through", "Something went wrong just now", "Stuck here for a moment, hang on"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感，全局，所有宠物共用） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力（合法，
  //   抛掷后匀速直线飞行/永不回落，配合 restitution/groundFriction=0 即纯无重力漂浮）。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界，
  //   抛掷可飞出屏幕顶部（超出可视区域，重力仍会拉回落）。默认 true。
  // throwPower：总力度（拖拽/抛掷输出增益）。弹簧跟手（K/C）、甩抛初速与软上限 3600 整体 ×p：
  //   1.0 = 现状；>1 = 跟手更贴、甩得更猛、可达到的上限更高；<1 = 松弛、更易温柔放下。必须 > 0。
  // petCollision：多宠物互相碰撞开关。true = 飞行中被甩出的宠物撞到其它宠物时，
  //   按动量守恒 + 恢复系数 0.995 弹开（质量 ∝ size²）；false = 关闭（默认，宠物互相穿过）。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 默认宠物列表（多开） =====================
  // pets 数组定义默认宠物；「设置页 → 添加宠物」的默认模板取 pets[0]（main）。
  // 每个宠物独立：name（显示名，可重复：悬浮提示 / AI 人设追加「你的名字是X」/ 未来命令行定位的
  //   显示层。可省略——缺失或留空按该宠物 id 处理并告警，兼容旧配置）、
  // id（唯一标识，程序定位用：素材/记忆/端点参数都按它，绝不重叠，冲突即配置错误）、
  // size（宽度 px，高度自动 = size × 9/16）、
  // balanceEnabled（是否启用余额功能：true=触发余额动画+显示余额气泡；false=该宠物完全禁用。
  //   必填布尔值，缺失即配置错误）、display（显示位置，必填四值之一：
  //   web=仅浏览器 overlay / desktop=仅桌面模式（Electron 透明窗）/ both=两者/ none=都不显示。
  //   缺失按默认 both 处理并告警（兼容 ≤0.2.0 旧配置），写了非法值即配置错误；桌面模式渲染
  //   display 含 desktop/both 的全部宠物，每只一个局部小窗）、
  // position（corner: 四角之一；marginX/marginY: 距所属角落偏移 px）
  "pets": [
    {
      "name": "Blue-Haired Little Maid",
      "id": "main",
      "size": 462,
      "balanceEnabled": true,
      // 碎碎念默认关闭：每次生成都会调用当前对话的模型。本地 LLM 单并发时，
      // 后台碎碎念会顶掉正在跑的任务的 KV cache（与 DSH 多子代理同因）。
      // 需要碎碎念的宠物改为 true（设置页也可开关）。
      "whisperEnabled": false,
      // 工作状态联动默认关闭：开启后监听 DSH 会话事件（工具调用等），按
      // animations.events.workStatus 数组切档位动画 + 气泡（仅监听，不调用模型）。
      "workStatusEnabled": false,
      "display": "both",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  // 动画素材目录（用户自定义 / 覆盖包内素材）：
  //   $DSH_HOME/dsh-pet/main-animation/webm/（如 C:\Users\<你>\.dsh\dsh-pet\main-animation\webm\）
  //   —— 唯一格式 .webm，文件名必须与下面各池写定的动画名一致（不含扩展名，中文/空格都行）。
  //   注意：素材要放在 main-animation\webm\ 子目录里，直接放 main-animation\ 下会查不到文件。
  //   （症状：右键菜单照常显示名字——菜单来自本配置——但点击不播放，资源 404。）
  //   素材归属：存在 pet/<素材根>-animation/ 的文件宠物只查自己的目录（绝不回落）；
  //   主配置宠物（main 等）按 main-animation\webm 优先 → 包内 assets/webm 依次查找。
  "animations": {
    // 待机动画池（数组，可放多个，等概率抽）
    "idle": ["Idle breathing"],
    // 转向动画池（数组；每一项都必须是“播完会翻转朝向”的动画，如东张西望）
    "turn": ["Looking around"],
    // 拖拽动画池（数组；每一项都必须是“被无形抓起悬空”的姿势）
    "drag": ["Dangling while dragged"],
    // 点击回应动画池（点按宠物时触发，随机抽 1 个）
    "clicks": [
      "Click - happy hop",
      "Click - shy surprise",
      "Click - tsundere pout",
      "Click - ticklish giggle",
      "Click - cheerful wave"
    ],
    // 移动动画池：default 是每个动作都用的默认参数；actions 里每项可覆盖部分参数，
    // 未写的字段取 default。minDist/maxDist=单次行进距离(px)——以「基准宠物宽 462px」为准，
    //   运行时按 实际size/462 等比缩放（小宠物挪小步、大宠物挪大步，与人物大小匹配）；
    // margin=贴边安全距(px，不随缩放)、leadSec/tailSec=动画首尾各多少秒原地不动。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "Crab walk" },
        { "name": "Floating in place", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "Running in place", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // 随机动作：分类池。weight 为该分类出现权重；noMirror: true 表示“带文字、镜像会颠倒，
    // 宠物面向右（被镜像）时不播放该类”。所有分类 weight 合计应与 animationWeights 里
    // 顶层权重和的余量（100 − idle − turn − move）相等。
    "categories": [
      { "id": "Little gesture", "weight": 20, "actions": [
        "Humming along", "Big stretch", "Tapping the desk", "Squash down", "Yawning",
        "Napping in place", "Maid curtsey", "Startled", "Little 360 spin",
        "Caught snacking", "Whale tail slap", "Jolted awake", "Looking in the mirror", "Trying on outfits",
        "Taking notes", "Writing code", "Folding fan", "Morning brushing"
      ] },
      { "id": "Playing", "weight": 20, "actions": [
        "Solving a cube", "Playing with a toy car", "Whale bubbles", "Jump and smash",
        "Raging at a game", "Water pistol", "Playing violin", "Blue whale appears", "Elegant maid dance", "Bouncy dance",
        "Cute otaku dance", "Blowing a balloon", "Animals gather", "Flying a kite", "Unwrapping a gift", "Dove trick", "Card trick",
        "Spinning top", "Playing flute", "Butterflies and blossoms", "Petting a cat", "Flowers from nowhere", "Rocking horse",
        "Juggling", "Shuttlecock", "Playing gomoku", "On a swing"
      ] },
      { "id": "What to eat", "weight": 16, "actions": [
        "Plain rice", "Snacking hard", "Eating tokens", "Breakfast", "Lunch", "Dinner", "Ice cream meltdown",
        "Hairy crab", "Candied hawthorn", "Longevity noodles", "Watermelon", "Hotpot"
      ] },
      { "id": "Seasons", "weight": 14, "actions": [
        "Buried in leaves", "Mooncakes", "Building a snowman", "Fireworks", "Zongzi", "Rice cakes", "Green rice balls",
        "Laba porridge", "Chongyang cake", "Red envelope", "Writing a lucky charm", "Needle and thread", "Lion dance", "Trick or treat",
        "Chrysanthemums", "River lanterns", "Cute little ghost", "Decorating the tree", "Sky lanterns", "Tangyuan", "Dumplings"
      ] },
      { "id": "Text", "weight": 10, "noMirror": true, "actions": [
        "Yeah, what to eat", "Deep-thinking chatter"
      ] }
    ],
    // 事件动画：不进随机链（rollKind/pickNext 不会抽到），只由代码显式触发。
    // events.<事件名> 为档位数组，按「事件档位」顺序排列（索引即档位）。
    // 每个档位的值可以是：单个动画名（固定播，原行为）或候选数组（触发时档内随机抽 1，
    // 尽量不连续重复——同一档位多候选时不会连抽同一个）。空字符串/空数组非法。
    // balance（余额展示，按已用百分比分档，数组顺序 = 档位顺序）：
    //   index = p === 100 ? 5 : Math.floor(p / 20)
    //   即 index 0..4 覆盖 [0,20) [20,40) [40,60) [60,80) [80,100)，index 5 只在 p 恰为 100（全部用完）时播。
    //   与提示词文件 prompts/桌面宠物 10 秒动作提示词.md 的 6 段动画一一对应。
    "events": {
      "balance": [
        "Balance - purse overflowing",   // 0 ≤ p < 20（几乎未消耗）
        "Balance - coins jingling",   // 20 ≤ p < 40
        "Balance - purse as usual",   // 40 ≤ p < 60
        "Balance - counting, frowning",   // 60 ≤ p < 80
        "Balance - purse nearly empty",   // 80 ≤ p < 100（告急）
        "Balance - not a penny left"    // p === 100（全部用完，格外档）
      ],
      // 碎碎念：到点随机抽 1 段播（等概率），与 eventsRefreshSec.whisper 周期对应
      "whisper": [
        "Chatter - wiping the table",
        "Chatter - spacing out",
        "Chatter - at the screen"
      ],
      // 工作状态联动（pets[].workStatusEnabled 开启时）：按索引 = 状态档位，勿在中间插入新档
      //（新档只可追加到末尾，否则已生效配置的档位含义错位）：
      //   index 0 = thinking（turn/start 回合开）
      //   index 1 = working（tool/call 工具调用）
      //   index 2 = result（tool/result 工具完成回整理）
      //   index 3 = waiting（approval/asked 等待批准）
      //   index 4 = success（turn/end completed 完成）
      //   index 5 = error（turn/end error/max-tokens 出错/达上限）
      "workStatus": [
        "Work - thinking bubbles",      // index 0 thinking（turn/start 回合开）
        "Work - busy tapping",      // index 1 working（tool/call 工具调用）
        "Work - filing away",      // index 2 result（tool/result 工具完成回整理）
        "Work - pacing and peeking",  // index 3 waiting（approval/asked 等待批准）
        "Work - celebrating",      // index 4 success（turn/end completed 完成）
        "Work - head down, sighing"   // index 5 error（turn/end error/max-tokens 出错/达上限）
      ]
    }
  },

  // ===================== 事件触发周期 =====================
  // 事件名 → 刷新间隔（秒）。balance（余额）：余额数据刷新 + 余额动画触发的间隔，
  // 启动时立即触发一次，之后按此周期循环。非法数值（非正数/非数字）即配置错误。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 当前：10 + 5 + 5 + (20+20+16+14+10=80) = 100
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
